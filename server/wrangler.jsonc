{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quartz-rooms",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }]
  },
  // The free plan only allows SQLite-backed Durable Objects.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "vars": {
    // Pages that may connect. Comma-separated, exact origins.
    // `wrangler dev` uses .dev.vars instead, which allows the local app on localhost.
    "ALLOWED_ORIGINS": "https://punkkills.github.io"
  }
}
